{
	"name": "dragonscaler",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "deno task test:unit --run && deno task test:e2e",
		"test:e2e": "deno task test:e2e:preview && deno task test:e2e:shoulder",
		"test:e2e:preview": "node node_modules/@playwright/test/cli.js test",
		"test:e2e:shoulder": "node node_modules/@playwright/test/cli.js test --config playwright.shoulder.config.ts --grep shoulder"
	},
	"dependencies": {
		"@vaie/hui": "^0.2.1",
		"pocketbase": "^0.27.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.64.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"jsdom": "^29.1.1",
		"sass": "^1.100.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
